# Architecture and cooperative SMP profile.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_STATIC_LINK=y
CONFIG_LD_SCRIPT_STATIC=y
CONFIG_LOCALVERSION="-pocket.1"
# CONFIG_LOCALVERSION_AUTO is not set

# The runtime supplies a separate, measured initramfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# Image and managed-volume devices/filesystems.
CONFIG_BLK_DEV_UBD=y
# CONFIG_BLK_DEV_UBD_SYNC is not set
# CONFIG_BLK_DEV_NBD is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_POSIX_ACL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# Workload ABI and process supervision primitives.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Guest-only namespaces. Host user namespaces are never required.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# A loopback-capable guest stack is useful even in network-none mode. No host
# network transport is compiled into this first static profile.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
# Host networking. The vector driver's bess transport is an AF_UNIX socket
# to an unprivileged userspace stack, which is what lets a guest reach the
# network without TUN, CAP_NET_ADMIN or any host configuration. The gre and
# l2tpv3 transports are left off: they resolve their peer by name through
# NSS, which a statically linked UML cannot load, and STATIC_LINK is not
# negotiable here -- a dynamically linked kernel would bind the sealed
# profile to the host's libc.
CONFIG_UML_NET_VECTOR=y
# CONFIG_UML_NET_VECTOR_IP_TRANSPORTS is not set

# Explicit inherited-FD console and serial channels.
CONFIG_SSL=y
CONFIG_NULL_CHAN=y
# CONFIG_PORT_CHAN is not set
# CONFIG_PTY_CHAN is not set
CONFIG_TTY_CHAN=y
# CONFIG_XTERM_CHAN is not set
CONFIG_CON_ZERO_CHAN="fd:0,fd:1"
CONFIG_CON_CHAN="null"
CONFIG_SSL_CHAN="null"

# No out-of-band management channel, and no loadable code.
# Host directory sharing. This is how `--volume` gives a workload a real host
# folder rather than a copy: the guest mounts hostfs on an explicitly named
# host path. It grants the guest exactly the access the invoking user already
# has, which is consistent with a runtime that is deliberately not a boundary
# against hostile code, and nothing is mounted unless a volume asks for it.
CONFIG_HOSTFS=y
# CONFIG_MCONSOLE is not set
# CONFIG_MODULES is not set
# CONFIG_UML_TIME_TRAVEL_SUPPORT is not set

# Deterministic diagnostics without build-path-heavy debug information.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_KALLSYMS_ALL is not set

# Everything below exists so a container engine can run *inside* the guest.
#
# Doing that on a shared host kernel is what makes Docker-in-Docker risky:
# the inner container's privileges are privileges over the same kernel the
# host runs on. Here the guest has its own kernel, and the host boundary is
# an unprivileged process that these options do not touch, so granting the
# guest namespaces, overlayfs and netfilter costs the host nothing.
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y

# cgroup controllers a container engine looks for before it will start.
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y

# Container networking: veth pairs into a bridge, and NAT out of it.
CONFIG_NETDEVICES=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y

# Both iptables backends, because which one a distribution's docker uses is
# its choice, not ours: iptables-nft drives nf_tables, iptables-legacy drives
# the xtables path, and an engine that finds neither cannot publish a port.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# runc programs the device cgroup through eBPF on cgroup v2; without these it
# fails at container start with "bpf_prog_query(BPF_CGROUP_DEVICE) failed:
# function not implemented".
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# A container engine applies its own seccomp profile to what it starts. This
# is the guest kernel's filter support, and is unrelated to the UML host
# backend also called seccomp.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
