From: pocket_vm developers <pocket-vm@localhost>
Subject: [PATCH] um: vector: take the queue head locks with softirqs off

lockdep reports an inconsistent lock state on every boot of a UML guest
with a vector device:

  inconsistent {SOFTIRQ-ON-W} -> {IN-SOFTIRQ-W} usage.
  ksoftirqd/0/14 takes: (&result->head_lock) at: vector_poll
  state was registered at: vector_net_open ... devinet_ioctl ... sys_ioctl
    *** DEADLOCK ***

vector_poll() takes rx_queue->head_lock from NAPI, which runs in softirq
context.  Two callers take the same locks in process context with
softirqs enabled: vector_reset_stats(), reached through ndo_open, and
vector_get_ethtool_stats().  A softirq taken on the same CPU while
either holds the lock deadlocks against itself.

Use the _bh variants in those two, which are the only acquisitions not
already in softirq context.  vector_poll() is left alone because it runs
with softirqs already disabled, and vector_send() uses spin_trylock(),
which is safe from either context.
---
 arch/um/drivers/vector_kern.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/arch/um/drivers/vector_kern.c b/arch/um/drivers/vector_kern.c
index 8a70b3a..87b4f2d 100644
--- a/arch/um/drivers/vector_kern.c
+++ b/arch/um/drivers/vector_kern.c
@@ -111,19 +111,19 @@ static void vector_reset_stats(struct vector_private *vp)
 	 * in vector_poll.
 	 */
 
-	spin_lock(&vp->rx_queue->head_lock);
+	spin_lock_bh(&vp->rx_queue->head_lock);
 	vp->estats.rx_queue_max = 0;
 	vp->estats.rx_queue_running_average = 0;
 	vp->estats.rx_encaps_errors = 0;
 	vp->estats.sg_ok = 0;
 	vp->estats.sg_linearized = 0;
-	spin_unlock(&vp->rx_queue->head_lock);
+	spin_unlock_bh(&vp->rx_queue->head_lock);
 
 	/* TX stats are modified with TX head_lock held
 	 * in vector_send.
 	 */
 
-	spin_lock(&vp->tx_queue->head_lock);
+	spin_lock_bh(&vp->tx_queue->head_lock);
 	vp->estats.tx_timeout_count = 0;
 	vp->estats.tx_restart_queue = 0;
 	vp->estats.tx_kicks = 0;
@@ -131,7 +131,7 @@ static void vector_reset_stats(struct vector_private *vp)
 	vp->estats.tx_flow_control_xoff = 0;
 	vp->estats.tx_queue_max = 0;
 	vp->estats.tx_queue_running_average = 0;
-	spin_unlock(&vp->tx_queue->head_lock);
+	spin_unlock_bh(&vp->tx_queue->head_lock);
 }
 
 static int get_mtu(struct arglist *def)
@@ -1469,11 +1469,11 @@ static void vector_get_ethtool_stats(struct net_device *dev,
 	 * to date.
 	 */
 
-	spin_lock(&vp->tx_queue->head_lock);
-	spin_lock(&vp->rx_queue->head_lock);
+	spin_lock_bh(&vp->tx_queue->head_lock);
+	spin_lock_bh(&vp->rx_queue->head_lock);
 	memcpy(tmp_stats, &vp->estats, sizeof(struct vector_estats));
-	spin_unlock(&vp->rx_queue->head_lock);
-	spin_unlock(&vp->tx_queue->head_lock);
+	spin_unlock_bh(&vp->rx_queue->head_lock);
+	spin_unlock_bh(&vp->tx_queue->head_lock);
 }
 
 static int vector_get_coalesce(struct net_device *netdev,
