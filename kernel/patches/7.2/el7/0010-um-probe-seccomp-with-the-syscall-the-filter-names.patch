From: pocket_vm developers <pocket-vm@localhost>
Subject: [PATCH] um: probe seccomp with the syscall the filter names

Three things stop this probe from recognising a working host.

It calls sleep(0) to trigger a filter that traps clock_nanosleep.  glibc
before 2.18 returns from sleep(0) without entering the kernel at all, so the
trap never fires, the handler never exits 0, and the probe falls through to
its failure sentinel while the host's seccomp support is in fact complete.
Issue the syscall the filter actually names.

It also requires close_range(), a 5.9 syscall, purely as a stand-in for "the
stub will be able to shed its inherited descriptors".  That is no longer the
only way to do so -- userspace_tramp() enumerates /proc/self/fd where the
syscall is missing -- so gate on the mechanism this host will really use.
Anything other than success or a clean absence stays fatal.

Finally it clones the probe through libc, which corrupts this thread's cached
ids for the rest of the run; use the raw clone instead.

Check PR_SET_NO_NEW_PRIVS separately as well, so a refused no-new-privs is
not reported as a refused filter.
---
 arch/um/os-Linux/start_up.c | 94 +++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 90 insertions(+), 4 deletions(-)

diff --git a/arch/um/os-Linux/start_up.c b/arch/um/os-Linux/start_up.c
index 054ac03..17bcba9 100644
--- a/arch/um/os-Linux/start_up.c
+++ b/arch/um/os-Linux/start_up.c
@@ -18,6 +18,7 @@
 #include <sys/wait.h>
 #include <sys/time.h>
 #include <sys/resource.h>
+#include <time.h>
 #include <asm/ldt.h>
 #include <asm/unistd.h>
 #include <init.h>
@@ -237,8 +238,50 @@ extern unsigned long host_fp_size;
 extern unsigned long exec_regs[MAX_REG_NR];
 extern unsigned long *exec_fp_regs;
 
+/*
+ * The stub sheds its inherited descriptors with close_range(), a 5.9 syscall.
+ * Hosts without it enumerate /proc/self/fd instead (see userspace_tramp() in
+ * skas/process.c), but both paths still need the number to ask with.
+ */
+#ifndef __NR_close_range
+#define __NR_close_range 436
+#endif
+
 __initdata static struct stub_data *seccomp_test_stub_data;
 
+/*
+ * Confirm that the descriptor cleanup the trampoline will fall back to can
+ * actually run here, so that a host which cannot be enumerated is refused
+ * before the backend is promised rather than after it is relied upon.
+ *
+ * Raw syscalls only. This runs in the CLONE_VM | CLONE_VFORK child below,
+ * which shares its address space with a parent that is suspended until it
+ * exits, so libc calls that allocate or write errno reach into state the
+ * parent owns.
+ */
+static int __init check_proc_fd_enumeration(void)
+{
+	unsigned long long buffer[16];
+	long dirfd, bytes;
+
+	dirfd = stub_syscall4(__NR_openat, AT_FDCWD,
+			      (long)"/proc/self/fd",
+			      O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+	if (dirfd < 0)
+		return -1;
+
+	bytes = stub_syscall3(__NR_getdents64, dirfd,
+			      (long)buffer, sizeof(buffer));
+	stub_syscall1(__NR_close, dirfd);
+
+	/*
+	 * The directory holds at least ".", ".." and the descriptor just
+	 * opened, so a read that returns nothing means this host will not
+	 * enumerate and the descriptor guarantee cannot be met.
+	 */
+	return bytes > 0 ? 0 : -1;
+}
+
 static void __init sigsys_handler(int sig, siginfo_t *info, void *p)
 {
 	ucontext_t *uc = p;
@@ -264,11 +307,27 @@ static int __init seccomp_helper(void *data)
 		.len = ARRAY_SIZE(filter),
 		.filter = filter,
 	};
+	const struct timespec zero = {
+		.tv_sec = 0,
+		.tv_nsec = 0,
+	};
 	struct sigaction sa;
+	long res;
 
-	/* close_range is needed for the stub */
-	if (stub_syscall3(__NR_close_range, 1, ~0U, 0))
+	/*
+	 * The stub must be able to shed every descriptor it inherited before
+	 * it installs its filter. Gate on the cleanup this host will actually
+	 * perform rather than on close_range() being present: a host without
+	 * that syscall can still shed its descriptors exactly, by enumerating
+	 * them. Anything other than success or a clean absence is fatal.
+	 */
+	res = stub_syscall3(__NR_close_range, 1, ~0U, 0);
+	if (res == -ENOSYS) {
+		if (check_proc_fd_enumeration())
+			exit(1);
+	} else if (res != 0) {
 		exit(1);
+	}
 
 	set_sigstack(seccomp_test_stub_data->sigstack,
 			sizeof(seccomp_test_stub_data->sigstack));
@@ -279,12 +338,26 @@ static int __init seccomp_helper(void *data)
 	if (sigaction(SIGSYS, &sa, NULL) < 0)
 		exit(2);
 
-	prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
+	/*
+	 * Checked separately from the filter install so that a refused
+	 * no-new-privs is not reported as a refused filter.
+	 */
+	if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0)
+		exit(5);
+
 	if (syscall(__NR_seccomp, SECCOMP_SET_MODE_FILTER,
 			SECCOMP_FILTER_FLAG_TSYNC, &prog) != 0)
 		exit(3);
 
-	sleep(0);
+	/*
+	 * The filter above traps clock_nanosleep and the handler exits 0, so
+	 * returning from this call is the failure. Issue the syscall the
+	 * filter names, directly: glibc's sleep(0) returns without entering
+	 * the kernel at all before 2.18, which would fail this probe on a host
+	 * whose seccomp support is in fact complete.
+	 */
+	stub_syscall4(__NR_clock_nanosleep, CLOCK_MONOTONIC, 0,
+		      (long)&zero, 0);
 
 	/* Never reached. */
 	_exit(4);
@@ -315,10 +388,23 @@ static bool __init init_seccomp(void)
 	sp = (unsigned long)&seccomp_test_stub_data->syscall_data +
 	     sizeof(seccomp_test_stub_data->syscall_data) -
 	     sizeof(void *);
+	/*
+	 * Not libc's clone(): for CLONE_VM without CLONE_THREAD it clobbers
+	 * this thread's own cached process and thread ids, which older libc
+	 * then reads back for pthread_cancel() and pthread_sigqueue(). See
+	 * stub_clone_vm().
+	 */
+#ifdef STUB_CLONE_VM_AVAILABLE
+	pid = stub_clone_vm(seccomp_helper, (void *)sp,
+			    CLONE_VFORK | CLONE_VM, NULL);
+	if (pid < 0)
+		fatal("check_seccomp : clone failed, errno = %d\n", -pid);
+#else
 	pid = clone(seccomp_helper, (void *)sp, CLONE_VFORK | CLONE_VM, NULL);
 
 	if (pid < 0)
 		fatal_perror("check_seccomp : clone failed");
+#endif
 
 	CATCH_EINTR(n = waitpid(pid, &status, __WCLONE));
 	if (n < 0)
