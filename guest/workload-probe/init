#!/bin/sh

set -u

mount -t proc proc /proc || exit 30
mount -t sysfs sysfs /sys || exit 31
mount -t devtmpfs devtmpfs /dev || exit 32
mount -t ext4 /dev/ubda /volume || exit 33

if [ "$(cat /volume/.pocket-generation 2>/dev/null)" != pocket-root-v1 ]; then
    echo 'POCKET_WORKLOAD_ERROR generation-marker'
    poweroff -f
fi

mkdir -p /volume/rootfs/proc
mount -t proc proc /volume/rootfs/proc || exit 34

echo 'POCKET_WORKLOAD_BEGIN'
chroot /volume/rootfs /bin/sh -ceu '
    printf "uts_machine="
    uname -m
    printf "ubuntu_version="
    sed -n "s/^VERSION_ID=//p" /etc/os-release
    printf "guest_cpu_count="
    getconf _NPROCESSORS_ONLN
    printf "dynamic_loader="
    /bin/sh -c "printf ok"
    printf "\n"
'
status=$?
printf 'POCKET_WORKLOAD_STATUS=%s\n' "$status"

umount /volume/rootfs/proc
sync
umount /volume
poweroff -f

